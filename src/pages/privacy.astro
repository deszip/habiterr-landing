---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { CONTACT_EMAIL } from "../consts";
---

<Layout
  title="Privacy Policy — Habiterr"
  description="How Habiterr handles personal data and protects your privacy."
>
  <Header />
  <main id="main">
    <article class="article">
      <div class="wrap">
        <a class="back" href="/"><span class="ms" style="font-size:18px" aria-hidden="true">arrow_back</span>Home</a>
        <header>
          <span class="tagline">Effective Date: 25 January 2026</span>
          <h1>Privacy Policy</h1>
        </header>

        <div class="prose">
          <p>
            Habiterr prioritizes user privacy. We request personal information only when genuinely
            necessary to deliver services through the Habiterr app.
          </p>

          <p>
            Data collection follows fair and lawful practices with user awareness and consent. Users
            are informed about what information is gathered and its intended use.
          </p>

          <p>
            Information retention is limited to the duration required for service delivery. Stored
            data receives protection through commercially acceptable means to prevent loss and theft,
            as well as unauthorised access, disclosure, copying, use or modification. We do not
            publicly share or distribute personally identifying information to third parties unless
            legally required.
          </p>

          <p>
            External website links may appear in the app, but we disclaim responsibility for the
            content and privacy practices of those sites.
          </p>

          <p>
            Users may decline to provide personal information, though this may limit access to
            certain services.
          </p>

          <p>
            Continued app usage indicates acceptance of our privacy practices. Questions about data
            handling may be directed to
            <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
          </p>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
