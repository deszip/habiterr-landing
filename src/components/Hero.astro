---
import AppStoreBadge from "./AppStoreBadge.astro";
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="hero-copy" data-reveal>
      <span class="eyebrow">Habit tracker for iPhone</span>
      <h1>Track every habit<br /><span class="grad">you have.</span></h1>
      <p class="lede">
        Most apps punish you for missing a day. Habiterr uses gentle streaks that forgive the
        occasional slip, and a balance chart that keeps your whole life in view.
      </p>
      <div class="hero-ctas">
        <AppStoreBadge />
        <a class="link-arrow" href="#features">
          See how it works<span class="ms" aria-hidden="true">arrow_forward</span>
        </a>
      </div>
    </div>
    <div class="phone-stage" data-reveal>
      <figure class="device">
        <img
          class="device-screen"
          src="/assets/screen-home.png"
          alt="Habiterr home screen: a Study group with Reading, Math and Coursera, a Reading group with Atomic Habits and Dragon Book heatmaps, and a Cooking habit"
          width="1320"
          height="2868"
        />
        <img class="device-frame" src="/assets/iphone-frame.png" alt="" width="1470" height="3000" />
      </figure>
    </div>
  </div>
</section>
