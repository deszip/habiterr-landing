---
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
}
const { eyebrow, title, accent } = Astro.props;
---

<article
  class="reveal card p-7 flex flex-col gap-4 relative overflow-hidden"
  style={`--accent:${accent}`}
>
  <div
    class="absolute -top-20 -right-16 w-40 h-40 rounded-full opacity-50 pointer-events-none"
    style={`background: radial-gradient(circle, ${accent}33, transparent 70%); filter: blur(20px);`}
  ></div>
  <span class="text-xs uppercase tracking-widest font-semibold" style={`color:${accent}`}>
    {eyebrow}
  </span>
  <h3 class="text-xl font-semibold font-display tracking-tight">{title}</h3>
  <div class="text-sm text-[var(--color-text-muted)] leading-relaxed flex flex-col gap-3">
    <slot />
  </div>
</article>
