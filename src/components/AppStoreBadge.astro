---
interface Props {
  href?: string;
  height?: number;
  variant?: "badge" | "pill";
  label?: string;
}
const {
  href = "https://apps.apple.com/app/habiterr",
  height = 44,
  variant = "badge",
  label = "Download on the App Store",
} = Astro.props;
---

{
  variant === "pill" ? (
    <a href={href} class="appstore-pill" aria-label={label}>
      <svg width="16" height="18" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true">
        <path d="M318 272c-1-79 64-117 67-119-36-53-93-60-113-61-48-5-94 28-118 28-25 0-62-27-103-26-53 1-101 31-128 78-55 95-14 235 39 312 26 38 57 80 97 79 39-2 53-25 100-25s60 25 101 24c42-1 68-38 93-76 30-44 42-86 43-89-1 0-82-31-83-125zM244 84c21-26 36-62 32-98-31 1-69 21-92 47-20 23-37 60-32 95 35 3 70-18 92-44z" />
      </svg>
      {label}
    </a>
  ) : (
    <a href={href} aria-label={label} style={`display:inline-flex; height:${height}px;`}>
      <svg
        viewBox="0 0 135 40"
        height={height}
        xmlns="http://www.w3.org/2000/svg"
        role="img"
        aria-label={label}
      >
        <rect x="0.5" y="0.5" width="134" height="39" rx="7.5" fill="#000" stroke="rgba(255,255,255,0.18)" />
        <g fill="#fff">
          <path
            transform="translate(11 8)"
            d="M16.7 12.4c0-2.2 1.8-3.3 1.9-3.3-1-1.5-2.6-1.7-3.2-1.7-1.3-.1-2.6.8-3.3.8-.7 0-1.7-.8-2.9-.7-1.5 0-2.8.9-3.6 2.2-1.5 2.7-.4 6.6 1.1 8.8.7 1.1 1.6 2.3 2.7 2.2 1.1 0 1.5-.7 2.8-.7 1.3 0 1.7.7 2.9.7 1.2 0 2-1.1 2.7-2.1.9-1.2 1.3-2.4 1.3-2.5 0-.1-2.4-.9-2.4-3.7zM14.6 5.9c.6-.7 1-1.7.9-2.7-.8 0-1.8.6-2.4 1.3-.6.6-1.1 1.6-1 2.5.9.1 1.8-.4 2.5-1.1z"
          />
          <text
            x="34"
            y="16"
            font-family="-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif"
            font-size="7.5"
            opacity="0.85"
          >
            Download on the
          </text>
          <text
            x="34"
            y="29"
            font-family="-apple-system, BlinkMacSystemFont, 'Helvetica Neue', Arial, sans-serif"
            font-size="14"
            font-weight="600"
          >
            App Store
          </text>
        </g>
      </svg>
    </a>
  )
}
