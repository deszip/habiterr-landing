---
const items = [
  {
    problem: "Missed one day?",
    visual: "streak-x",
    solution: "Habiterr forgives it.",
    body: "Slip up after a long streak? Old apps reset you to zero. Gentle streaks treat one missed day as a small dip, not a failure.",
  },
  {
    problem: "One habit great, neglecting others?",
    visual: "lopsided",
    solution: "Balance shows the full picture.",
    body: "Running daily but never sleeping? The radar makes it obvious — and gives you one number that tracks how even your effort is.",
  },
  {
    problem: "Overwhelming dashboards?",
    visual: "clean",
    solution: "One screen. One radar. Always clear.",
    body: "No charts to swipe through. Open the app, see today at a glance, decide what's next in under five seconds.",
  },
];
---

<section class="section-pad relative">
  <div class="container-page">
    <div class="reveal max-w-2xl mb-12">
      <span class="eyebrow">Why Habiterr</span>
      <h2 class="h-section mt-4">
        Three frustrations most habit apps make worse.
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-5">
      {
        items.map((item, idx) => (
          <article
            class="reveal card p-7 flex flex-col gap-5 hover:border-[rgba(155,109,255,0.35)] transition-colors"
            style={`transition-delay: ${idx * 60}ms;`}
          >
            <div class="h-32 rounded-xl bg-[#0f0f13] border border-[var(--color-stroke)] flex items-center justify-center overflow-hidden relative">
              {item.visual === "streak-x" && (
                <svg viewBox="0 0 200 90" width="100%" height="100%" aria-hidden="true">
                  <g font-family="Inter, sans-serif" font-size="13" fill="#8e8e99">
                    {[1, 2, 3, 4, 5, 6, 7].map((d, i) => {
                      const x = 16 + i * 26;
                      return (
                        <g>
                          <rect
                            x={x - 9}
                            y="20"
                            width="22"
                            height="22"
                            rx="6"
                            fill={i < 5 ? "rgba(77,217,192,0.18)" : i === 5 ? "rgba(239,68,68,0.18)" : "rgba(255,255,255,0.04)"}
                            stroke={i < 5 ? "#4dd9c0" : i === 5 ? "#ef4444" : "rgba(255,255,255,0.08)"}
                            stroke-width="1"
                          />
                          {i < 5 && (
                            <path d={`M${x - 4} 31 l4 4 l8 -9`} stroke="#4dd9c0" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                          )}
                          {i === 5 && (
                            <g stroke="#ef4444" stroke-width="1.8" stroke-linecap="round">
                              <line x1={x - 4} y1="26" x2={x + 4} y2="36" />
                              <line x1={x + 4} y1="26" x2={x - 4} y2="36" />
                            </g>
                          )}
                          <text x={x} y="62" text-anchor="middle">{d}</text>
                        </g>
                      );
                    })}
                  </g>
                </svg>
              )}
              {item.visual === "lopsided" && (
                <svg viewBox="0 0 160 100" width="80%" height="80%" aria-hidden="true">
                  <polygon points="80,10 130,40 120,80 40,80 30,40" fill="none" stroke="rgba(255,255,255,0.08)" />
                  <polygon points="80,15 128,42 90,78 60,75 38,45" fill="rgba(249,115,22,0.25)" stroke="#f97316" stroke-width="1.4" />
                </svg>
              )}
              {item.visual === "clean" && (
                <div class="flex flex-col items-center gap-2">
                  <svg viewBox="0 0 80 80" width="64" height="64" aria-hidden="true">
                    <polygon points="40,10 66,25 66,55 40,70 14,55 14,25" fill="none" stroke="rgba(155,109,255,0.5)" stroke-width="1.4" />
                    <polygon points="40,18 60,28 58,52 40,62 22,52 20,30" fill="rgba(155,109,255,0.22)" stroke="#9b6dff" stroke-width="1.6" />
                  </svg>
                  <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-subtle)]">One screen</span>
                </div>
              )}
            </div>

            <div>
              <p class="text-sm text-[var(--color-text-muted)]">{item.problem}</p>
              <h3 class="mt-1 text-xl font-semibold text-white">{item.solution}</h3>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-text-muted)]">
                {item.body}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
