---
import Logo from "./Logo.astro";
import { CONTACT_EMAIL, SOCIAL_LINKS } from "../consts";
---

<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <Logo />
        <p class="tag">Build habits that last.</p>
      </div>
      <div>
        <h4>Product</h4>
        <ul>
          <li><a href="/#features">Features</a></li>
          <li><a href="/#metrics">Metrics</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>
      <div>
        <h4>Legal</h4>
        <ul>
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/eula">Terms of Use</a></li>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>Follow</h4>
        <ul>
          {SOCIAL_LINKS.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
        </ul>
      </div>
    </div>
    <p class="legal">© 2026 The Missing Bits. All rights reserved. Made for iPhone.</p>
  </div>
</footer>
