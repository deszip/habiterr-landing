---
import FeatureRow from "./FeatureRow.astro";
import RadarChart from "./RadarChart.astro";
---

<section id="features" class="section-pad">
  <div class="container-page">
    <div class="reveal max-w-2xl mb-16">
      <span class="eyebrow">Features</span>
      <h2 class="h-section mt-4">
        Two innovations. One screen. No noise.
      </h2>
      <p class="mt-5 text-lg text-[var(--color-text-muted)] leading-relaxed">
        Flexible tracking, fresh habit metrics, and an interface built to make
        daily use feel effortless.
      </p>
    </div>

    <div class="flex flex-col gap-24 lg:gap-32">
      <FeatureRow
        eyebrow="01 — Radar Chart"
        title="See all your habits at once."
        body="Six axes, one shape. The further out, the better. The instant you open the app, you know exactly where you stand — and what's pulling the shape lopsided."
      >
        <div slot="visual" class="card p-6 md:p-8 relative">
          <RadarChart size={460} />

          <div class="mt-6 pt-6 border-t border-[var(--color-stroke)] grid grid-cols-2 gap-4">
            {
              [
                {
                  label: "Consistency",
                  value: 78,
                  color: "#f97316",
                  glow: "rgba(249,115,22,0.25)",
                  bgFrom: "rgba(249,115,22,0.18)",
                  bgTo: "rgba(249,115,22,0.04)",
                  border: "rgba(249,115,22,0.25)",
                },
                {
                  label: "Balance",
                  value: 87,
                  color: "#9b6dff",
                  glow: "rgba(155,109,255,0.25)",
                  bgFrom: "rgba(155,109,255,0.18)",
                  bgTo: "rgba(155,109,255,0.04)",
                  border: "rgba(155,109,255,0.25)",
                },
              ].map((g) => {
                const r = 75;
                const arc = Math.PI * r;
                const offset = arc * (1 - g.value / 100);
                return (
                  <div
                    class="rounded-2xl p-4 flex flex-col items-center"
                    style={`background: linear-gradient(160deg, ${g.bgFrom}, ${g.bgTo}); border:1px solid ${g.border};`}
                  >
                    <div class="relative w-full" style="max-width:180px;">
                      <svg viewBox="0 0 180 110" width="100%" aria-hidden="true">
                        <path
                          d="M 15 100 A 75 75 0 0 1 165 100"
                          fill="none"
                          stroke="rgba(255,255,255,0.08)"
                          stroke-width="12"
                          stroke-linecap="round"
                        />
                        <path
                          d="M 15 100 A 75 75 0 0 1 165 100"
                          fill="none"
                          stroke={g.color}
                          stroke-width="12"
                          stroke-linecap="round"
                          class="gauge-arc ring-progress"
                          style={`--ring-circumference: ${arc.toFixed(2)}; --ring-offset: ${offset.toFixed(2)}; filter: drop-shadow(0 0 12px ${g.glow});`}
                        />
                      </svg>
                      <div
                        class="absolute inset-x-0 bottom-1 text-center font-display font-bold text-3xl md:text-4xl"
                        style={`color:${g.color};`}
                      >
                        {g.value}%
                      </div>
                    </div>
                    <div
                      class="mt-2 text-xs uppercase tracking-widest"
                      style={`color:${g.color};`}
                    >
                      {g.label}
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </FeatureRow>

      <FeatureRow
        eyebrow="02 — Gentle Streaks"
        title="Streaks that survive real life."
        body="Real consistency isn't perfection. Habiterr lets you miss roughly 1 in 10 days without nuking your streak. You stay motivated, not punished."
        reverse
      >
        <div slot="visual" class="card p-6 md:p-8">
          <div class="text-xs uppercase tracking-widest text-[var(--color-text-subtle)] mb-3">
            The 10% rule
          </div>
          <div class="space-y-3 font-mono text-[13px]">
            <div class="flex items-center justify-between p-3 rounded-lg bg-[#0f0f13] border border-[var(--color-stroke)]">
              <span class="text-[var(--color-text-muted)]">30-day streak</span>
              <span class="text-white">3 misses allowed</span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-lg bg-[#0f0f13] border border-[var(--color-stroke)]">
              <span class="text-[var(--color-text-muted)]">60-day streak</span>
              <span class="text-white">6 misses allowed</span>
            </div>
            <div class="flex items-center justify-between p-3 rounded-lg bg-[rgba(155,109,255,0.06)] border border-[rgba(155,109,255,0.3)]">
              <span class="text-[var(--color-text-muted)]">100-day streak</span>
              <span class="text-[#c4b0ff]">10 misses allowed</span>
            </div>
          </div>
          <p class="mt-5 text-sm text-[var(--color-text-muted)] leading-relaxed">
            <span class="text-white font-medium">Formula:</span> max(1,&nbsp;floor(streak × 0.10)).
            One bad week won't undo months of effort.
          </p>
        </div>
      </FeatureRow>

      <FeatureRow
        eyebrow="03 — Consistency + Balance"
        title="Two numbers that tell the whole story."
        body="Consistency tells you how often you show up. Balance tells you whether you're showing up across every habit, not just your favorite. Together, that's your week."
      >
        <div slot="visual" class="card p-6 md:p-8 grid grid-cols-2 gap-4">
          <div
            class="rounded-2xl p-5 flex flex-col gap-3"
            style="background: linear-gradient(160deg, rgba(249,115,22,0.18), rgba(249,115,22,0.04)); border:1px solid rgba(249,115,22,0.25);"
          >
            <span class="text-xs uppercase tracking-widest text-[#f97316]">Consistency</span>
            <span class="font-display text-5xl font-bold" style="color:#f97316;">78%</span>
            <span class="text-xs text-[var(--color-text-muted)]">good range</span>
            <div class="h-1.5 rounded-full bg-black/40 mt-auto">
              <div class="h-full rounded-full" style="width:78%; background:#f97316;"></div>
            </div>
          </div>
          <div
            class="rounded-2xl p-5 flex flex-col gap-3"
            style="background: linear-gradient(160deg, rgba(155,109,255,0.18), rgba(155,109,255,0.04)); border:1px solid rgba(155,109,255,0.25);"
          >
            <span class="text-xs uppercase tracking-widest text-[#9b6dff]">Balance</span>
            <span class="font-display text-5xl font-bold" style="color:#9b6dff;">87%</span>
            <span class="text-xs text-[var(--color-text-muted)]">excellent</span>
            <div class="h-1.5 rounded-full bg-black/40 mt-auto">
              <div class="h-full rounded-full" style="width:87%; background:#9b6dff;"></div>
            </div>
          </div>
        </div>
      </FeatureRow>

      <FeatureRow
        eyebrow="04 — Tracking Types"
        title="Three ways to log real life."
        body="Use check-ins for yes-or-no habits, counters for repeated actions, and timers for focused sessions. Habiterr adapts to the habit instead of forcing everything into one checkbox."
        reverse
      >
        <div slot="visual" class="card p-6 md:p-8 grid gap-4">
          <div class="rounded-2xl border border-[rgba(77,217,192,0.25)] bg-[rgba(77,217,192,0.07)] p-5 flex items-center justify-between gap-4">
            <div>
              <div class="text-xs uppercase tracking-widest text-[#4dd9c0]">Check in</div>
              <div class="mt-1 text-sm text-[var(--color-text-muted)]">Meditate today</div>
            </div>
            <div class="w-11 h-11 rounded-full border border-[#4dd9c0] bg-[rgba(77,217,192,0.12)] flex items-center justify-center">
              <svg viewBox="0 0 32 32" width="24" height="24" aria-hidden="true">
                <path d="M9 16.5 l4.5 4.5 L23 10.5" stroke="#4dd9c0" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
          </div>
          <div class="rounded-2xl border border-[rgba(155,109,255,0.25)] bg-[rgba(155,109,255,0.07)] p-5 flex items-center justify-between gap-4">
            <div>
              <div class="text-xs uppercase tracking-widest text-[#9b6dff]">Counter</div>
              <div class="mt-1 text-sm text-[var(--color-text-muted)]">Water glasses</div>
            </div>
            <div class="font-display text-3xl font-bold text-[#c4b0ff]">6</div>
          </div>
          <div class="rounded-2xl border border-[rgba(249,115,22,0.25)] bg-[rgba(249,115,22,0.07)] p-5 flex items-center justify-between gap-4">
            <div>
              <div class="text-xs uppercase tracking-widest text-[#f97316]">Timer</div>
              <div class="mt-1 text-sm text-[var(--color-text-muted)]">Deep work</div>
            </div>
            <div class="font-mono text-xl font-semibold text-[#ffb17a]">25:00</div>
          </div>
        </div>
      </FeatureRow>
    </div>
  </div>
</section>
