---
interface Props {
  eyebrow?: string;
  title: string;
  body: string;
  reverse?: boolean;
  visualKey?: "radar" | "streaks" | "metrics" | "heatmap";
  screenshot?: string;
}
const { eyebrow, title, body, reverse = false, visualKey, screenshot } = Astro.props;
---

<div
  class="reveal grid lg:grid-cols-2 gap-10 lg:gap-16 items-center"
>
  <div class={reverse ? "lg:order-2" : ""}>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h3 class="h-section mt-4">{title}</h3>
    <p class="mt-5 text-[var(--color-text-muted)] leading-relaxed text-lg max-w-md">{body}</p>
    <slot name="extra" />
  </div>

  <div class={reverse ? "lg:order-1" : ""}>
    {
      screenshot ? (
        <div class="tpl aspect-[4/5] max-w-[420px] mx-auto">
          <span>{screenshot}</span>
        </div>
      ) : (
        <div class="relative">
          <slot name="visual">
            <div class="tpl aspect-[4/5] max-w-[420px] mx-auto">
              <span>{visualKey ?? "Feature visual"}</span>
            </div>
          </slot>
        </div>
      )
    }
  </div>
</div>
